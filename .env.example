# NextDNS MCP Server Configuration
# Copy this file to .env and fill in your values
# IMPORTANT: Never commit your .env file to git!

# Required: Your NextDNS API key
# Get it from: https://my.nextdns.io/account
NEXTDNS_API_KEY=your-api-key-here

# Optional: Default profile ID to use when not specified in requests
# NEXTDNS_DEFAULT_PROFILE=abc123

# There is no separate test-profile variable for writes: sandbox writes with NEXTDNS_WRITABLE_PROFILES / NEXTDNS_READ_ONLY further down this file.

# Optional: Profile to use for plotting tools during E2E tests
# Synthetic test profiles usually have no analytics data, so set this to a
# real profile that has query traffic if you want to test plotAnalytics* tools.
# NEXTDNS_PLOT_PROFILE=abc123

# Optional: HTTP request timeout in seconds (default: 30)
# Read once when the HTTP clients are first created, so changing it requires a
# process restart. See docs/configuration.md.
# NEXTDNS_HTTP_TIMEOUT=30

# Optional: Hard cap on the total bytes a single log download may stream to
# disk (default: 1 GiB). Must be a positive integer of bytes; an invalid value
# fails fast with a configuration error. A download that would exceed the cap
# is aborted mid-stream and its temp file is removed.
# NEXTDNS_DOWNLOAD_MAX_BYTES=1073741824

# FastMCP's automatic update check is already off by default because it slows
# startup and can hang in offline/CI environments. Set an explicit value
# (e.g. FASTMCP_CHECK_FOR_UPDATES=stable) to opt back in.
FASTMCP_CHECK_FOR_UPDATES=off

# FastMCP's HTTP host/origin header validation, which mitigates DNS rebinding
# against the unauthenticated HTTP endpoint. FastMCP's own default is "false";
# the container images set "auto", application runs do not.
# "auto" enforces the check on a loopback bind, and additionally Origin-checks
# any request presenting a loopback Host. It also allowlists Host headers, so a
# reverse proxy in front of 127.0.0.1 must be listed in FASTMCP_HTTP_ALLOWED_HOSTS
# or every request is answered with 421. Behind a TLS-terminating proxy the
# server also needs the proxy's address in FORWARDED_ALLOW_IPS (it defaults to
# 127.0.0.1, which covers a same-host proxy), so it reads the real scheme from
# X-Forwarded-Proto instead of comparing an http origin against the browser's
# https Origin and answering 403; set it to the proxy's address, never to "*",
# which would let a client spoof past the guard. The FASTMCP_HTTP_ALLOWED_HOSTS
# value is a JSON array, not a bare hostname. Set the protection to "false" ONLY
# if a reverse proxy in front of the server already enforces origin checks. See
# docs/configuration.md.
# FORWARDED_ALLOW_IPS=10.1.2.3
# FASTMCP_HTTP_ALLOWED_HOSTS=["mcp.example.com"]
# FASTMCP_HTTP_HOST_ORIGIN_PROTECTION=auto

# ===== MCP Transport =====
# How the MCP server talks to its client.
# stdio (default) is what Claude Desktop and CLI tools expect.
# Optional: Serve over streamable-HTTP instead of stdio.
# SECURITY: the HTTP endpoint has NO built-in authentication. It binds to
# 127.0.0.1 (loopback-only) by default. Setting MCP_HOST to a non-loopback
# address is an explicit opt-in that exposes every tool and your API key's full
# reachability to anyone who can reach the port; only do so behind a reverse
# proxy that provides authentication/TLS.
# MCP_TRANSPORT=stdio
# MCP_HOST=127.0.0.1
# Must be an integer in 1-65535; an invalid value fails fast with a
# configuration error. See docs/configuration.md.
# MCP_PORT=8000

# ===== Profile Access Control =====
# Control which profiles can be read from or written to by this MCP server
# SECURITY: Default behavior is DENY ALL access

# Optional: Comma-separated list of profile IDs that are allowed to be read
# Empty or unset = NO profiles can be read (deny all, secure default)
# "ALL" or "all" = all profiles can be read
# Example: NEXTDNS_READABLE_PROFILES=abc123,def456
# NEXTDNS_READABLE_PROFILES=

# Optional: Comma-separated list of profile IDs that are allowed to be written to
# Empty or unset = NO profiles can be written to (deny all, secure default)
# "ALL" or "all" = all profiles can be written to, production ones included,
#   so use it only against a dev account. See docs/safety.md.
# Write access automatically grants read access
# Example: NEXTDNS_WRITABLE_PROFILES=abc123
# NEXTDNS_WRITABLE_PROFILES=

# Optional: Enable read-only mode (disables ALL write operations)
# Set to true, 1, or yes to enable
# When enabled, no write operations are allowed regardless of profile access settings
# NEXTDNS_READ_ONLY=false

# Access Control Examples:
# 1. Allow all access (read and write):
#    NEXTDNS_READABLE_PROFILES=ALL
#    NEXTDNS_WRITABLE_PROFILES=ALL
#
# 2. Read-only access to all profiles:
#    NEXTDNS_READABLE_PROFILES=ALL
#    NEXTDNS_READ_ONLY=true
#
# 3. Only allow reading specific profiles:
#    NEXTDNS_READABLE_PROFILES=abc123,def456
#
# 4. Only allow writing to a test profile (must also grant read access):
#    NEXTDNS_READABLE_PROFILES=test123
#    NEXTDNS_WRITABLE_PROFILES=test123
#
# 5. Restrict both read and write to specific profiles:
#    NEXTDNS_READABLE_PROFILES=abc123,def456,test789
#    NEXTDNS_WRITABLE_PROFILES=test789
