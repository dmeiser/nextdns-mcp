# Git / GitHub
.git/
.github/

# The workflow-revision checkout docker-publish.yml stages for the version CLI;
# it is a second copy of the repository and never part of the image.
workflow-ref/

# Python cache / virtual environments
__pycache__/
*.pyc
*.pyo
*.pyd
.venv/
venv/
.mypy_cache/
.ruff_cache/

# Test / coverage artifacts
tests/
.pytest_cache/
htmlcov/
.coverage
.coverage.*

# Build / local artifacts
artifacts/
scripts/artifacts/
scripts/*.jsonl
*.jsonl

# Local configuration / secrets
.env
.env.*
!.env.example
# Local MCP client config: the real one carries the API key inline, and the
# example is never needed at runtime. Keep both out of the build context.
opencode.json
opencode.json.example

# Documentation (not needed at runtime)
docs/

# IDE / editor files
.vscode/
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db
